generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         Int        @id @default(autoincrement())
  nombre     String
  subdominio String     @unique
  email      String
  telefono   String?
  logoUrl    String?
  activo     Boolean    @default(true)
  vencimiento DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  usuarios   Usuario[]
  servicios  Servicio[]
  reservas   Reserva[]
  horarios   Horario[]
  vehiculos  Vehiculo[]
  bloqueos   Bloqueo[]
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       String   @default("admin")
  tenantId  Int?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
}

model Servicio {
  id       Int       @id @default(autoincrement())
  nombre   String
  duracion Int // minutos
  activo   Boolean   @default(true)
  tenantId Int
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  reservas Reserva[]
}

model Horario {
  id              Int     @id @default(autoincrement())
  diaSemana       Int     // 0=Domingo, 1=Lunes ... 6=Sábado
  horaInicio      String  // "09:00"
  horaFin         String  // "18:00"
  inicioColacion  String? // "13:00" — null = sin colación
  finColacion     String? // "14:00" — null = sin colación
  activo          Boolean @default(true)
  tenantId        Int
  tenant          Tenant  @relation(fields: [tenantId], references: [id])
}

model Bloqueo {
  id          Int      @id @default(autoincrement())
  fecha       DateTime // fecha del bloqueo (día completo o parcial)
  horaInicio  String?  // null = día completo bloqueado
  horaFin     String?  // null = día completo bloqueado
  motivo      String?
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
}

model Vehiculo {
  id          Int       @id @default(autoincrement())
  patente     String
  marca       String?
  modelo      String?
  anio        Int?
  kilometraje Int?
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  reservas    Reserva[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([patente, tenantId])
}

model Reserva {
  id          Int       @id @default(autoincrement())
  nombre      String
  telefono    String
  email       String?
  patente     String
  fecha       DateTime
  estado      String    @default("confirmada") // confirmada | atendida | cancelada
  notas       String?
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  servicioId  Int
  servicio    Servicio  @relation(fields: [servicioId], references: [id])
  vehiculoId  Int?
  vehiculo    Vehiculo? @relation(fields: [vehiculoId], references: [id])
  kilometraje Int?
  createdAt   DateTime  @default(now())
}
