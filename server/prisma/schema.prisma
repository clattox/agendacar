generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         Int        @id @default(autoincrement())
  nombre     String
  subdominio String     @unique
  email      String
  telefono   String?
  direccion  String?
  logoUrl    String?
  activo     Boolean    @default(true)
  vencimiento DateTime?
  capacidad          Int        @default(1) // vehículos simultáneos (1-4)
  inspeccionActiva   Boolean    @default(true)
  recordatorioActivo Boolean    @default(false)
  recordatorioHora   Int        @default(20)  // hora en Chile (0-23)
  recordatorioDias   String     @default("1,2,3,4,5") // días semana JS (0=Dom..6=Sáb)
  categoria          String     @default("generica") // generica|serviteca|mecanica|pintura|electromecanica
  colorPrimario      String     @default("#f59e0b") // color de acento hex
  // Datos de emisión de cotizaciones
  rut                String?    // RUT del taller (para PDF)
  banco              String?
  tipoCuenta         String?
  numeroCuenta       String?
  cotizacionValidez  Int        @default(15) // días de validez de cotización
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  usuarios   Usuario[]
  servicios  Servicio[]
  reservas   Reserva[]
  horarios   Horario[]
  vehiculos    Vehiculo[]
  bloqueos     Bloqueo[]
  slots        SlotDisponible[]
  trabajadores Trabajador[]
  catalogoVehiculos CatalogoVehiculo[]
}


model SlotDisponible {
  id         Int    @id @default(autoincrement())
  diaSemana  Int    // 0=Domingo, 1=Lunes ... 6=Sábado
  hora       String // "09:00"
  tenantId   Int
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, diaSemana, hora])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol           String       @default("admin")
  tenantId      Int?
  tenant        Tenant?      @relation(fields: [tenantId], references: [id])
  inspecciones  Inspeccion[]
  createdAt     DateTime     @default(now())
}

model Servicio {
  id                  Int       @id @default(autoincrement())
  nombre              String
  duracion            Int // minutos
  activo              Boolean   @default(true)
  requiereInspeccion  Boolean   @default(false)
  tenantId            Int
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  reservas            Reserva[]
}

model Horario {
  id              Int     @id @default(autoincrement())
  diaSemana       Int     // 0=Domingo, 1=Lunes ... 6=Sábado
  horaInicio      String  // "09:00"
  horaFin         String  // "18:00"
  inicioColacion  String? // "13:00" — null = sin colación
  finColacion     String? // "14:00" — null = sin colación
  activo          Boolean @default(true)
  tenantId        Int
  tenant          Tenant  @relation(fields: [tenantId], references: [id])
}

model Bloqueo {
  id          Int      @id @default(autoincrement())
  fecha       DateTime // fecha del bloqueo (día completo o parcial)
  horaInicio  String?  // null = día completo bloqueado
  horaFin     String?  // null = día completo bloqueado
  motivo      String?
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
}

model Vehiculo {
  id          Int       @id @default(autoincrement())
  patente     String
  marca       String?
  modelo      String?
  anio        Int?
  kilometraje Int?
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  reservas    Reserva[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([patente, tenantId])
}

model Reserva {
  id          Int        @id @default(autoincrement())
  nombre      String
  telefono    String
  email       String?
  patente     String
  fecha       DateTime
  estado      String     @default("confirmada") // confirmada | inspeccionada | atendida | cancelada
  notas       String?
  tenantId    Int
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  servicioId  Int
  servicio    Servicio   @relation(fields: [servicioId], references: [id])
  vehiculoId  Int?
  vehiculo    Vehiculo?  @relation(fields: [vehiculoId], references: [id])
  kilometraje Int?
  createdAt   DateTime   @default(now())
  inspeccion  Inspeccion?
  trabajadores Trabajador[] // quiénes atendieron el vehículo (opcional)
  cierre      CierreAtencion?
  cotizacion  Cotizacion?
}

model Inspeccion {
  id                  Int              @id @default(autoincrement())
  reservaId           Int              @unique
  reserva             Reserva          @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tenantId            Int
  realizadaPorId      Int?
  realizadaPor        Usuario?         @relation(fields: [realizadaPorId], references: [id])
  trabajadorId        Int?
  trabajador          Trabajador?      @relation(fields: [trabajadorId], references: [id])
  observaciones       String?
  clienteConfirmo     Boolean          @default(false)
  fechaConfirmacion   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  danos               DanoInspeccion[]
}

model Trabajador {
  id           Int          @id @default(autoincrement())
  nombre       String
  cargo        String?      // Ej: "Mecánico", "Recepcionista"
  activo       Boolean      @default(true)
  tenantId     Int
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  inspecciones Inspeccion[]
  reservas     Reserva[]    // reservas en las que participó
  createdAt    DateTime     @default(now())
}

model DanoInspeccion {
  id            Int        @id @default(autoincrement())
  inspeccionId  Int
  inspeccion    Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  tipo          String     // rayon | abolladura | piquete | otro
  vista         String     // lateral | frontal | trasera | superior
  posX          Float      // porcentaje 0-100 sobre el SVG
  posY          Float      // porcentaje 0-100 sobre el SVG
  ubicacion     String?    // descripción textual de la zona
  descripcion   String?    // nota libre
  createdAt     DateTime   @default(now())
}

model CierreAtencion {
  id        Int          @id @default(autoincrement())
  reservaId Int          @unique
  reserva   Reserva      @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tenantId  Int
  notas     String?
  createdAt DateTime     @default(now())
  items     ItemCierre[]
}

model ItemCierre {
  id          Int            @id @default(autoincrement())
  cierreId    Int
  cierre      CierreAtencion @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  descripcion String
  cantidad    Int            @default(1)
  valor       Float          @default(0)
}

model Cotizacion {
  id               Int              @id @default(autoincrement())
  numero           Int?             // correlativo por tenant
  reservaId        Int              @unique
  reserva          Reserva          @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tenantId         Int
  notas            String?
  clienteRut       String?          // RUT del cliente/empresa (opcional)
  clienteDireccion String?
  clienteComuna    String?
  incluyeIva       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  items            ItemCotizacion[]
}

model ItemCotizacion {
  id           Int        @id @default(autoincrement())
  cotizacionId Int
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  descripcion  String
  cantidad     Int        @default(1)
  valor        Float      @default(0) // precio unitario
}

model CatalogoVehiculo {
  id       Int    @id @default(autoincrement())
  marca    String
  modelo   String
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([marca, modelo, tenantId])
}
