generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         Int        @id @default(autoincrement())
  nombre     String
  subdominio String     @unique
  email      String
  telefono   String?
  direccion  String?
  logoUrl    String?
  activo     Boolean    @default(true)
  vencimiento DateTime?
  capacidad          Int        @default(1) // vehículos simultáneos (1-4)
  inspeccionActiva   Boolean    @default(true)
  flotaActiva        Boolean    @default(false)
  soloFlota          Boolean    @default(false)  // si true: solo accede al módulo de flota (sin taller)
  // Alertas de documentos de flota
  alertaDocActiva    Boolean    @default(false)
  alertaDocDias      String     @default("20,10,5") // días antes del vencimiento separados por coma
  recordatorioActivo Boolean    @default(false)
  recordatorioHora   Int        @default(20)  // hora en Chile (0-23)
  recordatorioDias   String     @default("1,2,3,4,5") // días semana JS (0=Dom..6=Sáb)
  categoria          String     @default("generica") // generica|serviteca|mecanica|pintura|electromecanica
  colorPrimario      String     @default("#f59e0b") // color de acento hex
  // Datos de emisión de cotizaciones
  rut                String?    // RUT del taller (para PDF)
  banco              String?
  tipoCuenta         String?
  numeroCuenta       String?
  cotizacionValidez  Int        @default(15) // días de validez de cotización
  cotizacionDesde    Int        @default(1)  // número desde donde parte el correlativo
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  usuarios   Usuario[]
  servicios  Servicio[]
  reservas   Reserva[]
  horarios   Horario[]
  vehiculos    Vehiculo[]
  bloqueos     Bloqueo[]
  slots        SlotDisponible[]
  trabajadores Trabajador[]
  catalogoVehiculos CatalogoVehiculo[]
  egresos           Egreso[]
}


model SlotDisponible {
  id         Int    @id @default(autoincrement())
  diaSemana  Int    // 0=Domingo, 1=Lunes ... 6=Sábado
  hora       String // "09:00"
  tenantId   Int
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, diaSemana, hora])
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol           String       @default("admin")  // admin | conductor | superadmin
  tenantId      Int?
  tenant        Tenant?      @relation(fields: [tenantId], references: [id])
  inspecciones  Inspeccion[]
  conductor     Conductor?   // si rol=conductor, aquí está su perfil de flota
  createdAt     DateTime     @default(now())
}

model Servicio {
  id                  Int       @id @default(autoincrement())
  nombre              String
  duracion            Int // minutos
  activo              Boolean   @default(true)
  requiereInspeccion  Boolean   @default(false)
  tenantId            Int
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  reservas            Reserva[]
}

model Horario {
  id              Int     @id @default(autoincrement())
  diaSemana       Int     // 0=Domingo, 1=Lunes ... 6=Sábado
  horaInicio      String  // "09:00"
  horaFin         String  // "18:00"
  inicioColacion  String? // "13:00" — null = sin colación
  finColacion     String? // "14:00" — null = sin colación
  activo          Boolean @default(true)
  tenantId        Int
  tenant          Tenant  @relation(fields: [tenantId], references: [id])
}

model Bloqueo {
  id          Int      @id @default(autoincrement())
  fecha       DateTime // fecha del bloqueo (día completo o parcial)
  horaInicio  String?  // null = día completo bloqueado
  horaFin     String?  // null = día completo bloqueado
  motivo      String?
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
}

model Vehiculo {
  id          Int       @id @default(autoincrement())
  patente     String
  marca       String?
  modelo      String?
  anio        Int?
  kilometraje Int?
  tenantId    Int
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  reservas    Reserva[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([patente, tenantId])
}

model Reserva {
  id          Int        @id @default(autoincrement())
  nombre      String
  telefono    String
  email       String?
  patente     String
  fecha       DateTime
  estado      String     @default("confirmada") // confirmada | inspeccionada | atendida | cancelada
  notas       String?
  tenantId    Int
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  servicioId  Int
  servicio    Servicio   @relation(fields: [servicioId], references: [id])
  vehiculoId  Int?
  vehiculo    Vehiculo?  @relation(fields: [vehiculoId], references: [id])
  kilometraje Int?
  createdAt   DateTime   @default(now())
  inspeccion  Inspeccion?
  trabajadores Trabajador[] // quiénes atendieron el vehículo (opcional)
  cierre      CierreAtencion?
  cotizacion  Cotizacion?
}

model Inspeccion {
  id                  Int              @id @default(autoincrement())
  reservaId           Int              @unique
  reserva             Reserva          @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tenantId            Int
  realizadaPorId      Int?
  realizadaPor        Usuario?         @relation(fields: [realizadaPorId], references: [id])
  trabajadorId        Int?
  trabajador          Trabajador?      @relation(fields: [trabajadorId], references: [id])
  observaciones       String?
  clienteConfirmo     Boolean          @default(false)
  fechaConfirmacion   DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  danos               DanoInspeccion[]
}

model Trabajador {
  id           Int          @id @default(autoincrement())
  nombre       String
  cargo        String?      // Ej: "Mecánico", "Recepcionista"
  activo       Boolean      @default(true)
  tenantId     Int
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  inspecciones Inspeccion[]
  reservas     Reserva[]    // reservas en las que participó
  createdAt    DateTime     @default(now())
}

model DanoInspeccion {
  id            Int        @id @default(autoincrement())
  inspeccionId  Int
  inspeccion    Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  tipo          String     // rayon | abolladura | piquete | otro
  vista         String     // lateral | frontal | trasera | superior
  posX          Float      // porcentaje 0-100 sobre el SVG
  posY          Float      // porcentaje 0-100 sobre el SVG
  ubicacion     String?    // descripción textual de la zona
  descripcion   String?    // nota libre
  createdAt     DateTime   @default(now())
}

model CierreAtencion {
  id         Int          @id @default(autoincrement())
  reservaId  Int          @unique
  reserva    Reserva      @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tenantId   Int
  notas      String?
  incluyeIva Boolean      @default(true)
  total      Float        @default(0)
  createdAt  DateTime     @default(now())
  items      ItemCierre[]
}

model ItemCierre {
  id          Int            @id @default(autoincrement())
  cierreId    Int
  cierre      CierreAtencion @relation(fields: [cierreId], references: [id], onDelete: Cascade)
  descripcion String
  cantidad    Int            @default(1)
  valor       Float          @default(0)
}

model Cotizacion {
  id               Int              @id @default(autoincrement())
  numero           Int?             // correlativo por tenant
  reservaId        Int              @unique
  reserva          Reserva          @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tenantId         Int
  notas            String?
  clienteRut       String?          // RUT del cliente/empresa (opcional)
  clienteDireccion String?
  clienteComuna    String?
  incluyeIva       Boolean          @default(false)
  fechaEmision     DateTime?        // fecha de emisión editable (null = usa createdAt)
  horaIngreso      String?          // hora real de ingreso del vehículo "HH:MM" (ej: "17:00")
  linkEvidencia    String?          // enlace Google Drive con fotos del vehículo
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  items            ItemCotizacion[]
}

model ItemCotizacion {
  id           Int        @id @default(autoincrement())
  cotizacionId Int
  cotizacion   Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  descripcion  String
  cantidad     Int        @default(1)
  valor        Float      @default(0) // precio unitario
}

model CatalogoVehiculo {
  id       Int    @id @default(autoincrement())
  marca    String
  modelo   String
  tenantId Int
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([marca, modelo, tenantId])
}

model Egreso {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fecha       DateTime @default(now())
  descripcion String
  monto       Float
  createdAt   DateTime @default(now())
}

// ================================================================
// CONTROL DE FLOTA
// ================================================================

enum EstadoVehiculo {
  OPERATIVO
  EN_TALLER
  FUERA_DE_SERVICIO
}

enum TipoActividad {
  KILOMETRAJE
  COMBUSTIBLE
  PEAJE
  MANTENCION
  CAMBIO_ESTADO
  TRASLADO
}

enum TipoCombustible {
  DIESEL
  BENCINA_93
  BENCINA_95
  BENCINA_97
}

enum SentidoPeaje {
  IDA
  VUELTA
  IDA_Y_VUELTA
}

enum TipoMantencion {
  CAMBIO_ACEITE
  CAMBIO_FILTROS
  NEUMATICOS
  FRENOS
  BATERIA
  CORREA_DISTRIBUCION
  MANTENCION_GENERAL
  OTRO
  REVISION_TECNICA
  PERMISO_CIRCULACION
  SOAP
  SEGURO_VOLUNTARIO
}

enum TipoDocumento {
  REVISION_TECNICA
  SOAP
  PERMISO_CIRCULACION
  SEGURO_VOLUNTARIO
  PADRON
}

enum TipoDocumentoConductor {
  LICENCIA_CONDUCIR
  CEDULA_IDENTIDAD
  CERTIFICADO_ANTECEDENTES
  OTRO
}

model Conductor {
  id                String    @id @default(cuid())
  tenantId          Int

  nombre            String
  rut               String?
  licenciaNumero    String?
  licenciaCategoria String?
  licenciaVence     DateTime?
  telefono          String?
  email             String?
  activo            Boolean   @default(true)

  usuarioId         Int?      @unique  // cuenta de acceso al portal conductor
  usuario           Usuario?  @relation(fields: [usuarioId], references: [id])

  flotaVehiculos    FlotaVehiculo[]
  estadosCambios    EstadoCambioFlota[]
  actividades       FlotaActividad[]
  documentos        ConductorDocumento[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, activo])
}

model FlotaVehiculo {
  id                  String              @id @default(cuid())
  tenantId            Int

  marca               String
  modelo              String
  anio                Int
  patente             String
  color               String?
  categoria           String?
  numeroInterno       String?
  region              String?
  unidadOperativa     String?

  estado              EstadoVehiculo      @default(OPERATIVO)
  odometroActual      Int                 @default(0)

  conductorId         String?
  conductor           Conductor?          @relation(fields: [conductorId], references: [id])

  proxMantencionKm    Int?
  proxMantencionFecha DateTime?

  tieneTag            Boolean             @default(false)
  saldoCupon          Int                 @default(0)

  documentos          VehiculoDocumento[]
  actividades         FlotaActividad[]
  estadosCambios      EstadoCambioFlota[]
  planesMantencion    PlanMantencionVehiculo[]

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([tenantId, patente])
  @@index([tenantId])
  @@index([tenantId, estado])
}

model VehiculoDocumento {
  id               String        @id @default(cuid())
  tenantId         Int
  vehiculoId       String
  vehiculo         FlotaVehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  tipo             TipoDocumento

  fechaEmision     DateTime?
  fechaVencimiento DateTime

  numeroDocumento  String?
  monto            Int?
  proveedor        String?
  archivoBase64    String?       // PDF en base64
  archivoNombre    String?       // nombre original del archivo

  // Permiso de Circulación en cuotas
  cuotas              Int       @default(1)   // 1 o 2
  segundaCuotaPagada  Boolean   @default(false)
  segundaCuotaFecha   DateTime?               // fecha de pago de la 2ª cuota

  activo           Boolean       @default(true)

  createdAt        DateTime      @default(now())

  @@index([tenantId])
  @@index([vehiculoId, tipo])
  @@index([fechaVencimiento])
}

model ConductorDocumento {
  id              String                  @id @default(cuid())
  tenantId        Int
  conductorId     String
  conductor       Conductor               @relation(fields: [conductorId], references: [id], onDelete: Cascade)

  tipo            TipoDocumentoConductor

  fechaEmision     DateTime?
  fechaVencimiento DateTime?             // null = sin vencimiento (ej: cédula indefinida)

  numeroDocumento  String?
  categoria        String?               // para licencia: A1, B, C, D, etc.
  archivoBase64    String?               // PDF o imagen en base64
  archivoNombre    String?

  activo           Boolean               @default(true)

  createdAt        DateTime              @default(now())

  @@index([tenantId])
  @@index([conductorId, tipo])
  @@index([fechaVencimiento])
}

model FlotaActividad {
  id              String        @id @default(cuid())
  tenantId        Int
  vehiculoId      String
  vehiculo        FlotaVehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  tipo            TipoActividad
  fecha           DateTime

  registradoPorId String?
  registradoPor   Conductor?    @relation(fields: [registradoPorId], references: [id])
  notas           String?

  kmRegistro             KmRegistro?
  combustibleRegistro    CombustibleRegistro?
  peajeRegistro          PeajeRegistro?
  mantencionRegistro     MantencionRegistro?
  estadoCambio           EstadoCambioFlota?
  trasladoRegistro       TrasladoRegistro?

  createdAt       DateTime      @default(now())

  @@index([tenantId])
  @@index([vehiculoId])
  @@index([vehiculoId, tipo])
  @@index([tenantId, fecha])
}

model KmRegistro {
  id             String         @id @default(cuid())
  actividadId    String         @unique
  actividad      FlotaActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  odometroActual Int
  kmRecorridos   Int?
}

model CombustibleRegistro {
  id               String          @id @default(cuid())
  actividadId      String          @unique
  actividad        FlotaActividad  @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  tipoCombustible  TipoCombustible
  litros           Decimal         @db.Decimal(8, 2)
  monto            Int
  precioLitro      Int?
  odometroAlCargar Int?
  estacion         String?
  ciudadEstacion   String?
}

model PeajeRegistro {
  id          String         @id @default(cuid())
  actividadId String         @unique
  actividad   FlotaActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  monto       Int            @default(0)
  esTag       Boolean        @default(false)
  autopista   String?
  sentido     SentidoPeaje   @default(IDA)
  proposito   String?
}

model MantencionRegistro {
  id           String         @id @default(cuid())
  actividadId  String         @unique
  actividad    FlotaActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  tipo         TipoMantencion
  descripcion  String?
  taller       String?
  costo        Int?
  odometro     Int?
  numeroFolio  String?

  proxFecha    DateTime?
  proxKm       Int?
}

// Log de alertas de documentos enviadas — evita reenvíos duplicados
model AlertaDocumentoLog {
  id           String   @id @default(cuid())
  tenantId     Int
  documentoId  String
  diasRestantes Int     // 20, 10 o 5 — el umbral que disparó la alerta
  enviadoEn    DateTime @default(now())

  @@unique([documentoId, diasRestantes])
  @@index([tenantId])
}

model TrasladoRegistro {
  id          String         @id @default(cuid())
  actividadId String         @unique
  actividad   FlotaActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  destino      String
  motivo       String?
  kmSalida     Int?
  kmLlegada    Int?
  fechaSalida  DateTime? // hora real en que se inició el traslado
  fechaLlegada DateTime? // hora real en que se registró la llegada

  @@index([actividadId])
}

model EstadoCambioFlota {
  id                   String         @id @default(cuid())
  actividadId          String         @unique
  actividad            FlotaActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)

  vehiculoId           String
  vehiculo             FlotaVehiculo  @relation(fields: [vehiculoId], references: [id])

  estadoAnterior       EstadoVehiculo
  estadoNuevo          EstadoVehiculo
  motivo               String?

  tallerNombre         String?
  fechaRetornoEstimada DateTime?

  conductorAsignadoId  String?
  conductorAsignado    Conductor?     @relation(fields: [conductorAsignadoId], references: [id])

  @@index([vehiculoId])
}

model PlantillaMantencion {
  id           String   @id @default(cuid())
  tenantId     Int
  nombre       String
  tipoRef      TipoMantencion?
  intervalKm   Int?
  intervalDias Int?
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())

  planes       PlanMantencionVehiculo[]

  @@index([tenantId])
  @@index([tenantId, activa])
}

model PlanMantencionVehiculo {
  id           String   @id @default(cuid())
  tenantId     Int
  vehiculoId   String
  vehiculo     FlotaVehiculo       @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  plantillaId  String
  plantilla    PlantillaMantencion @relation(fields: [plantillaId], references: [id])

  kmBase       Int?
  fechaBase    DateTime?
  kmProximo    Int?
  fechaProxima DateTime?

  activo       Boolean  @default(true)
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([vehiculoId, plantillaId])
  @@index([tenantId])
  @@index([vehiculoId])
}
